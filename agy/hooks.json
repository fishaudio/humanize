{
  "humanize-rlcr": {
    "PreToolUse": [
      {
        "matcher": "write_file|write_to_file|edit_file|replace_file_content|multi_replace_file_content|sed_file|notebook_edit|read_file|view_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./runtime/hooks/agy-hook.sh pre-tool",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./runtime/hooks/agy-hook.sh post-tool",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "./runtime/hooks/agy-hook.sh stop",
        "timeout": 7200
      }
    ]
  }
}
